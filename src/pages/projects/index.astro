---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
import { getProjectCollection } from "utils/content";
import { getProjectPathName } from "utils/url";
import { getTitle } from "utils/title";

const projects = await getProjectCollection();
---

<BaseLayout title={getTitle("Projects")} description="Selected product and engineering work by Bagus Merta.">
  <main class="min-h-screen bg-[#080808]">
    <BackLink />
    <div class="reference-shell pb-24 pt-24">
      <div class="relative mb-16 aspect-video w-full overflow-hidden">
        <img src="/images/new-web-assets/projects.jpg" alt="A product workspace" width="1600" height="1198" loading="eager" class="h-full w-full object-cover" />
      </div>

      <ul class="m-0 space-y-8 p-0">
        {projects.map(project => (
          <li class="list-none">
            <a class="group grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-8 sm:gap-x-12" href={getProjectPathName(project)}>
              <div class="min-w-0">
                <h2 class="m-0 text-base font-bold lowercase text-ink transition-colors group-hover:text-white">{project.data.title}</h2>
                <p class="mb-0 mt-1 text-sm lowercase leading-relaxed text-[#777f77]">{project.data.description}</p>
              </div>
              <span class="pt-0.5 text-right text-xs text-[#777f77]">{project.data.createdDate.getFullYear()}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
