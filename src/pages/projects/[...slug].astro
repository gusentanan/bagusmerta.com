---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ImageEnhancer } from "@components/ui/ImageEnhancer";

export async function getStaticPaths() {
  const entries = await getCollection("project");
  return entries.map(entry => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const status = entry.data.status.charAt(0).toUpperCase() + entry.data.status.slice(1);
---

<BaseLayout title={`${entry.data.title} | Bagus Merta`} description={entry.data.description} banner={entry.data.image.src}>
  <main class="article-shell min-h-screen pb-6 pt-16 md:pb-10 md:pt-10">
    <BackLink href="/projects" />

    <header class="mb-12">
      <h1 class="mb-4 text-3xl font-bold leading-tight tracking-[-0.02em] text-ink md:text-4xl">{entry.data.title}</h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-[#777f77]">
        <span>{entry.data.createdDate.getFullYear()}</span><span>•</span><span>{status}</span>
        {entry.data.role && <><span>•</span><span>{entry.data.role}</span></>}
      </div>
    </header>

    <article class="prose max-w-none">
      <p>{entry.data.description}</p>
      <Image src={entry.data.image} width={1200} height={630} alt={entry.data.title} loading="eager" class="w-full" />
      <p><a href={entry.data.link} target="_blank" rel="noopener noreferrer">view project ↗</a></p>
      <ImageEnhancer client:load><Content /></ImageEnhancer>
    </article>
  </main>
</BaseLayout>
