---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
import { getBlogCollection } from "utils/content";
import { getBlogPathName } from "utils/url";
import { getTitle } from "utils/title";

const posts = await getBlogCollection();
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title={getTitle("Blog")} description="Notes on software, work, and life by Bagus Merta.">
  <main class="min-h-screen bg-[#080808]">
    <BackLink />
    <div class="reference-shell pb-24 pt-24">
      <div class="relative mb-16 aspect-video w-full overflow-hidden">
        <img src="/images/new-web-assets/blog.jpg" alt="A city street at night" width="1600" height="1184" loading="eager" class="h-full w-full object-cover" />
      </div>

      <ul class="m-0 space-y-8 p-0">
        {posts.map(post => (
          <li class="list-none">
            <a class="group block" href={getBlogPathName(post)}>
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="m-0 text-base font-bold lowercase text-ink transition-colors group-hover:text-white">{post.data.title}</h2>
                <span class="shrink-0 text-xs text-[#777f77]">{isoDate(post.data.date)}</span>
              </div>
              <p class="mb-0 mt-1 text-sm lowercase leading-relaxed text-[#777f77]">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
