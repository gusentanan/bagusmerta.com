---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
import { getBlogPostByTag, getBlogTags } from "utils/posts";
import { getBlogPathName } from "utils/url";
import { getTitle } from "utils/title";

export async function getStaticPaths() {
  const tags = await getBlogTags();
  return tags.map(tag => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = await getBlogPostByTag(tag);
const isoDate = (date: Date) => date.toISOString().slice(0, 10);
---

<BaseLayout title={getTitle(`Writing: ${tag}`)} description={`Writing about ${tag} by Bagus Merta.`}>
  <main class="min-h-screen bg-[#080808]">
    <BackLink href="/blog" />
    <div class="reference-shell pb-24 pt-24">
      <div class="relative mb-16 aspect-video w-full overflow-hidden">
        <img src="/images/new-web-assets/blog.jpg" alt="A city street at night" width="1600" height="1184" loading="eager" class="h-full w-full object-cover" />
      </div>
      <p class="mb-8 text-sm lowercase text-[#777f77]">{tag}</p>
      <ul class="m-0 space-y-8 p-0">
        {posts.map(post => (
          <li class="list-none">
            <a class="group block" href={getBlogPathName(post)}>
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="m-0 text-base font-medium lowercase text-ink">{post.data.title}</h2>
                <span class="shrink-0 text-xs text-[#777f77]">{isoDate(post.data.date)}</span>
              </div>
              <p class="mb-0 mt-1 text-sm lowercase leading-relaxed text-[#777f77]">{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</BaseLayout>
