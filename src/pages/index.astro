---
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getTitle } from "utils/title";

const links = [
  { label: "about", href: "/about" },
  { label: "selected work", href: "/projects" },
  { label: "writing", href: "/blog" },
  { label: "bookmarks", href: "/bookmarks" },
];
---

<BaseLayout
  title={getTitle("Home")}
  description="Bagus Merta is a product engineer in Bali building thoughtful mobile and web software."
>
  <main class="min-h-screen bg-[#080808]">
    <section class="reading-shell py-12 md:py-20">
      <h1 class="mb-6 text-xl font-semibold tracking-[-0.02em] text-ink md:text-2xl">
        Bagus Merta. 良い
      </h1>

      <div class="max-w-[40rem] space-y-4 text-[15px] leading-7 text-[#d2d0c9] md:text-base">
        <p class="m-0 text-inherit">
          Product engineer.
        </p>
        <p class="m-0 text-inherit">
          Currently a mobile engineer at
          <a href="https://wineadore.com" target="_blank" rel="noopener noreferrer" class="quiet-link">Wine Adore</a>,
          building the mobile experience for wine lovers.
        </p>
      </div>

      <div class="relative mt-9">
        <img
          src="/images/new-web-assets/home.jpg"
          alt="A lakeside landscape at dusk"
          width="1400"
          height="592"
          loading="eager"
          class="aspect-[2/1] w-full object-cover object-center"
        />
        <div class="pointer-events-none absolute inset-0 bg-black/10"></div>
        <div class="absolute right-4 top-4 flex items-center gap-4 text-[28px] text-white/70 md:right-5 md:top-5">
          <a class="pointer-events-auto transition-colors hover:text-white" href="https://github.com/gusentanan" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <Icon name="ri:github-line" aria-hidden="true" />
          </a>
          <a class="pointer-events-auto transition-colors hover:text-white" href="https://linkedin.com/in/bagusmerta" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <Icon name="ri:linkedin-line" aria-hidden="true" />
          </a>
          <a class="pointer-events-auto transition-colors hover:text-white" href="mailto:merta.bagus24@gmail.com" aria-label="Email">
            <Icon name="ri:mail-line" aria-hidden="true" />
          </a>
        </div>
      </div>

      <nav class="mt-10" aria-label="Explore Bagus Merta">
        <ul class="flex flex-col gap-4">
          {links.map(link => (
            <li><a class="index-link" href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="mt-16 flex items-center justify-between border-t border-line pt-5 font-code text-[10px] uppercase tracking-[0.12em] text-faint">
        <span>Bali, Indonesia · GMT+8</span>
        <a href="mailto:merta.bagus24@gmail.com" class="transition-colors hover:text-ink">Say hello ↗</a>
      </div>
    </section>
  </main>
</BaseLayout>
