---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
import CollectionBanner from "@components/ui/CollectionBanner.astro";
import { getBookMarkCollection } from "utils/content";
import { getTitle } from "utils/title";

const bookmarks = await getBookMarkCollection();
const domain = (url: string) => {
  try {
    return new URL(url).hostname.replace("www.", "");
  } catch {
    return "";
  }
};
---

<BaseLayout
  title={getTitle("Bookmarks")}
  description="Articles, tools, books, and sites saved by Bagus Merta."
>
  <main class="min-h-screen bg-[#080808]">
    <BackLink />
    <div class="reference-shell pb-24 pt-24">
      <CollectionBanner
        title="Bookmarks"
        description="Saved reads and ideas."
        image={{ src: "/images/new-web-assets/bookmarks.jpg", alt: "An outdoor cafe at night", width: 1600, height: 1096 }}
      />

      <ul class="m-0 space-y-8 p-0">
        {
          bookmarks.map((bookmark) => (
            <li class="list-none">
              <a
                class="content-list-link group block"
                href={bookmark.data.link}
                target="_blank"
                rel="noopener noreferrer"
              >
                <div>
                  <h2 class="content-list-title m-0 text-base font-bold lowercase text-ink">
                    {bookmark.data.title}
                  </h2>
                </div>
                <p class="content-list-description two-line-clamp mb-0 mt-1 text-sm lowercase leading-relaxed text-[#777f77]">
                  {bookmark.data.description}
                </p>
                <p class="content-list-meta mb-0 mt-1 text-xs lowercase text-[#555b55]">
                  {domain(bookmark.data.link)}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</BaseLayout>
