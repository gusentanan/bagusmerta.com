---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
import CompanyPreviewCard from "@components/ui/CompanyPreviewCard.astro";
import { getNicewordsCollection } from "utils/content";
import { getTitle } from "utils/title";

const niceWords = await getNicewordsCollection();
const experiences = [
  {
    name: "Wine Adore",
    role: "senior mobile engineer",
    period: "present",
    description: "building the mobile experience for wine lovers.",
    website: {
      href: "https://wineadore.com",
      label: "wineadore.com",
      icon: "/images/company-icons/wineadore.webp",
    },
  },
  {
    name: "Archipelago Technologies",
    role: "mobile engineer",
    period: "2023",
    description: "first big boy job.",
    website: null,
  },
  {
    name: "Avatar Solution",
    role: "android developer",
    period: "2022",
    description: "part-time, contract—anything to keep food on the table.",
    website: {
      href: "https://www.avatar.co.id/",
      label: "avatar.co.id",
      icon: "/images/company-icons/avatar.webp",
    },
  },
] as const;
const companyTriggerClass = "company-trigger border-0 bg-transparent p-0 text-ink underline decoration-white/30 underline-offset-4 transition-colors hover:text-white hover:decoration-white/80 focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-white";
---

<BaseLayout title={getTitle("About")} description="About Bagus Merta, a product engineer based in Bali.">
  <main class="reference-shell min-h-screen pb-6 pt-16 md:pb-10 md:pt-10">
    <BackLink />

    <div class="relative mb-8 aspect-video overflow-hidden">
      <img src="/images/new-web-assets/about-backdrop.jpg" alt="A team working together at sunset" class="h-full w-full object-cover" />
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent p-5 md:p-6">
        <div class="flex items-center gap-4">
          <img src="/images/new-web-assets/avatar.jpg" alt="Bagus Merta" class="h-16 w-16 rounded-full object-cover md:h-20 md:w-20" />
          <div>
            <h1 class="mb-1 text-xl font-bold text-ink">Bagus Merta</h1>
            <p class="m-0 text-xs lowercase text-white/80 md:text-sm">product engineer | mobile engineer</p>
          </div>
        </div>
      </div>
    </div>

    <div class="space-y-8">
      <section class="pb-4">
        <h2 class="mb-4 inline-block text-sm font-bold lowercase tracking-wide text-ink">experience</h2>
        <div class="space-y-6">
          {experiences.map((experience, index) => (
            <div class="relative pl-4">
              <h3 class="m-0 text-base font-bold lowercase text-ink">
                {experience.role} @{" "}
                {experience.website ? (
                  <a href={experience.website.href} target="_blank" rel="noopener noreferrer" class={companyTriggerClass} aria-describedby={`company-preview-${index}`}>{experience.name}</a>
                ) : (
                  <button type="button" class={companyTriggerClass} aria-describedby={`company-preview-${index}`}>{experience.name}</button>
                )}
                <span id={`company-preview-${index}`} role="tooltip" class="company-preview pointer-events-none absolute bottom-[calc(100%+0.75rem)] left-0 z-30 block w-full max-w-[21rem]">
                  <CompanyPreviewCard company={experience} />
                </span>
              </h3>
              <p class="mb-2 mt-1 text-xs text-[#777f77]">{experience.period}</p>
              <p class="m-0 text-sm lowercase leading-relaxed text-[#777f77]">{experience.description}</p>
            </div>
          ))}
        </div>
      </section>

       <div class="space-y-8">
      <section class="pb-4">
        <h2 class="mb-4 inline-block text-sm font-bold lowercase tracking-wide text-ink">education</h2>
        <div class="space-y-6">
          <div class="pl-4">
            <p class="m-0 text-sm lowercase leading-relaxed text-[#777f77]">cs @ udayana university</p>
         
          </div>
        
        </div>
      </section>

       <div class="space-y-8">
      <section class="pb-4">
        <h2 class="mb-4 inline-block text-sm font-bold lowercase tracking-wide text-ink">language</h2>
        <div class="space-y-6">
          <div class="pl-4">
            <p class="m-0 text-sm lowercase leading-relaxed text-[#777f77]">english, indonesian, balinese, japanese (a bit)</p>
         
          </div>
        
        </div>
      </section>


      <section class="pb-4">
        <h2 class="mb-4 inline-block text-sm font-bold lowercase tracking-wide text-ink">elsewhere</h2>
        <p class="m-0 pl-4 text-sm lowercase text-[#777f77]">
          <a class="quiet-link" href="https://github.com/gusentanan" target="_blank" rel="noopener noreferrer">github</a>,
          <a class="quiet-link" href="https://linkedin.com/in/bagusmerta" target="_blank" rel="noopener noreferrer">linkedin</a>,
          <a class="quiet-link" href="mailto:merta.bagus24@gmail.com">email</a>
        </p>
      </section>
    </div>
  </main>
</BaseLayout>
