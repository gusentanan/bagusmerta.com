---
import BaseLayout from "@layouts/BaseLayout.astro";
import BackLink from "@components/ui/BackLink.astro";
---

<BaseLayout title="404: Not Found">
  <main class="reading-shell flex min-h-[65vh] flex-col justify-center py-20">
    <BackLink />
    <p class="page-kicker mb-5">404 · Not found</p>
    <h1 class="m-0 font-display text-6xl font-normal leading-none text-ink md:text-8xl">Wrong turn.</h1>
    <p class="mb-0 mt-6 max-w-md text-sm leading-6 text-muted">The page may have moved, been deleted, or never existed.</p>
    <a href="/" class="quiet-link mt-8 w-max text-sm">Back home →</a>
  </main>
</BaseLayout>
