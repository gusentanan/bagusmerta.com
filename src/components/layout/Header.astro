---
const path = Astro.url.pathname;
const links = [
  { label: "About", href: "/about" },
  { label: "Work", href: "/projects" },
  { label: "Writing", href: "/blog" },
  { label: "Bookmarks", href: "/bookmarks" },
];
---

<header class="site-header">
  <div class="site-shell flex flex-col items-start justify-between gap-4 py-6 sm:flex-row sm:items-center sm:gap-6 sm:py-7">
    <a href="/" class="text-[15px] font-semibold tracking-[-0.01em] text-ink transition-opacity hover:opacity-60">
      Bagus Merta
    </a>
    <nav aria-label="Primary navigation">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 sm:gap-6">
        {links.map(link => (
          <li>
            <a
              href={link.href}
              aria-current={path.startsWith(link.href) ? "page" : undefined}
              class:list={[
                "text-xs sm:text-sm transition-colors",
                path.startsWith(link.href) ? "text-ink" : "text-muted hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
